              "minLength": 1
            }
          }
        },
        "decisions": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "working_copy": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validation": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
