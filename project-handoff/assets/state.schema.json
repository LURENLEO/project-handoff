      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_id",
        "stream_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
