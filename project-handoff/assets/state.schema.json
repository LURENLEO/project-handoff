              "minLength": 1
            }
          }
        }
      }
    },
    "intent": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "type": "object",
          "required": [
            "original_goal",
            "current_goal",
            "acceptance",
            "scope",
            "non_goals",
            "corrections"
          ],
          "properties": {
            "original_goal": {
              "type": "string",
              "minLength": 1
            },
            "current_goal": {
              "type": "string",
              "minLength": 1
            },
            "acceptance": {
              "type": "array"
            },
            "scope": {
              "type": "array"
            },
            "non_goals": {
              "type": "array"
            },
            "corrections": {
              "type": "array"
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "authorization": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "project": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "architecture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fact"
          },
          {
            "type": "object",
            "required": [
              "status",
              "acceptance",
              "done",
              "remaining",
              "files",
              "depends_on"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "blocked",
                  "implemented_unverified",
                  "verified",
                  "cancelled"
                ]
              },
              "acceptance": {
                "type": "array"
              },
              "done": {
                "type": "array"
              },
              "remaining": {
                "type": "array"
              },
              "files": {
                "type": "array"
              },
              "depends_on": {
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "working_copy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fact"
          },
          {
            "type": "object",
            "required": [
              "result",
              "freshness",
              "started_at",
              "ended_at",
              "exit_code",
              "log",
              "code_fingerprint",
              "environment",
              "command"
            ],
            "properties": {
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "interrupted",
                  "unknown"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale",
                  "unknown"
                ]
              },
              "started_at": {},
              "ended_at": {},
              "exit_code": {},
              "log": {},
              "code_fingerprint": {},
              "environment": {},
              "command": {
                "type": "object",
                "required": [
                  "argv",
                  "cwd_ref",
                  "env_names",
                  "purpose",
                  "side_effects"
                ],
                "properties": {
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env_names": {
                    "type": "array"
                  },
                  "cwd_ref": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "side_effects": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "external_state": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
