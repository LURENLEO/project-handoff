{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-handoff.local/state.schema.json",
  "title": "Project Handoff semantic context 1.x",
  "type": "object",
  "required": [
    "schema_version",
    "coverage",
    "intent",
    "constraints",
    "authorization",
    "project",
    "instructions",
    "architecture",
    "work_items",
    "in_progress",
    "decisions",
    "working_copy",
    "validation",
    "environment",
    "external_state",
    "assets",
    "collaboration",
    "next_actions",
    "gaps",
    "snapshot_id",
    "parent_snapshot_id",
    "identity"
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "source",
        "observed_at",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user_message",
                "file",
                "tool_result",
                "external_reference",
                "agent_assessment"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "observed_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "intent",
        "constraints",
        "authorization",
        "project",
        "instructions",
        "architecture",
        "work_items",
        "in_progress",
        "decisions",
        "working_copy",
        "validation",
        "environment",
        "external_state",
        "assets",
        "collaboration",
        "next_actions",
        "gaps"
      ],
      "properties": {
        "intent": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "constraints": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "authorization": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
