      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fact"
          },
          {
            "type": "object",
            "required": [
              "task_id",
              "preconditions",
              "files",
              "action",
              "expected_result",
              "validation",
              "on_failure"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "preconditions": {
                "type": "array"
              },
              "files": {
                "type": "array"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "expected_result": {
                "type": "string",
                "minLength": 1
              },
              "validation": {
                "type": "string",
                "minLength": 1
              },
              "on_failure": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fact"
          },
          {
            "type": "object",
            "required": [
              "reason",
              "impact",
              "resolution"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
