            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "architecture": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
